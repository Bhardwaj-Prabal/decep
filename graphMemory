package org.example.dbUploader;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;

import java.io.File;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicInteger;

/**
 * In-Memory Graph Storage - Optimized for Large Graphs
 * Uses iterative algorithms to avoid StackOverflowError
 */
public class InMemoryGraphStorage {
    
    private final Map<String, GraphNode> nodeMap;
    private final Map<String, List<GraphEdge>> outgoingEdges;
    private final Map<String, List<GraphEdge>> incomingEdges;
    private final ObjectMapper mapper;
    
    public enum NodeType {
        METHOD, CLASS, PACKAGE
    }
    
    public static class GraphNode {
        public final String id;
        public final NodeType type;
        public final Map<String, Object> properties;
        
        public GraphNode(String id, NodeType type) {
            this.id = id;
            this.type = type;
            this.properties = new ConcurrentHashMap<>();
        }
        
        @SuppressWarnings("unchecked")
        public <T> T get(String key) {
            return (T) properties.get(key);
        }
        
        public void put(String key, Object value) {
            properties.put(key, value);
        }
    }
    
    public static class GraphEdge {
        private final String from;
        private final String to;
        private final String type;
        private final Map<String, Object> properties;
        
        public GraphEdge(String from, String to, String type) {
            this.from = from;
            this.to = to;
            this.type = type;
            this.properties = new ConcurrentHashMap<>();
        }
        
        public String getFrom() { return from; }
        public String getTo() { return to; }
        public String getType() { return type; }
        public Map<String, Object> getProperties() { return properties; }
        public void put(String key, Object value) { properties.put(key, value); }
    }
    
    public InMemoryGraphStorage() {
        this.nodeMap = new ConcurrentHashMap<>();
        this.outgoingEdges = new ConcurrentHashMap<>();
        this.incomingEdges = new ConcurrentHashMap<>();
        this.mapper = new ObjectMapper();
    }
    
    public GraphNode addNode(String id, NodeType type) {
        return addNode(id, type, null);
    }
    
    public GraphNode addNode(String id, NodeType type, Map<String, Object> properties) {
        GraphNode node = nodeMap.computeIfAbsent(id, k -> new GraphNode(k, type));
        if (properties != null) {
            node.properties.putAll(properties);
        }
        return node;
    }
    
    public GraphNode getNode(String id) {
        return nodeMap.get(id);
    }
    
    public Collection<GraphNode> getAllNodes() {
        return nodeMap.values();
    }
    
    public GraphEdge addEdge(String fromId, String toId, String edgeType) {
        return addEdge(fromId, toId, edgeType, null);
    }
    
    public GraphEdge addEdge(String fromId, String toId, String edgeType, Map<String, Object> properties) {
        if (!nodeMap.containsKey(fromId)) {
            addNode(fromId, detectNodeType(fromId));
        }
        if (!nodeMap.containsKey(toId)) {
            addNode(toId, detectNodeType(toId));
        }
        
        GraphEdge edge = new GraphEdge(fromId, toId, edgeType);
        if (properties != null) {
            edge.properties.putAll(properties);
        }
        
        outgoingEdges.computeIfAbsent(fromId, k -> new ArrayList<>()).add(edge);
        incomingEdges.computeIfAbsent(toId, k -> new ArrayList<>()).add(edge);
        
        return edge;
    }
    
    private NodeType detectNodeType(String id) {
        if (id.contains("#")) return NodeType.METHOD;
        else if (id.contains(".")) return NodeType.CLASS;
        else return NodeType.PACKAGE;
    }
    
    public List<GraphEdge> getOutgoingEdges(String nodeId) {
        return outgoingEdges.getOrDefault(nodeId, Collections.emptyList());
    }
    
    public List<GraphEdge> getIncomingEdges(String nodeId) {
        return incomingEdges.getOrDefault(nodeId, Collections.emptyList());
    }
    
    public Set<String> getSuccessors(String nodeId) {
        Set<String> successors = new HashSet<>();
        for (GraphEdge edge : getOutgoingEdges(nodeId)) {
            successors.add(edge.getTo());
        }
        return successors;
    }
    
    public Set<String> getPredecessors(String nodeId) {
        Set<String> predecessors = new HashSet<>();
        for (GraphEdge edge : getIncomingEdges(nodeId)) {
            predecessors.add(edge.getFrom());
        }
        return predecessors;
    }
    
    public List<String> getCallers(String methodId) {
        List<String> callers = new ArrayList<>();
        for (GraphEdge edge : getIncomingEdges(methodId)) {
            if (edge.getType().equals("CALLS") || edge.getType().equals("CALLS_EXTERNAL")) {
                callers.add(edge.getFrom());
            }
        }
        return callers;
    }
    
    public List<String> getCallees(String methodId) {
        List<String> callees = new ArrayList<>();
        for (GraphEdge edge : getOutgoingEdges(methodId)) {
            if (edge.getType().equals("CALLS") || edge.getType().equals("CALLS_EXTERNAL")) {
                callees.add(edge.getTo());
            }
        }
        return callees;
    }
    
    /**
     * ITERATIVE cycle detection - NO recursion to avoid StackOverflowError
     */
    public Set<String> detectCycles() {
        System.out.println("\n🔍 Detecting cycles (iterative)...");
        Set<String> cycleNodes = new HashSet<>();
        Set<String> visited = new HashSet<>();
        
        int processed = 0;
        int totalNodes = nodeMap.size();
        
        // Only check METHOD nodes (classes and packages don't participate in call cycles)
        List<String> methodNodes = new ArrayList<>();
        for (GraphNode node : nodeMap.values()) {
            if (node.type == NodeType.METHOD) {
                methodNodes.add(node.id);
            }
        }
        
        System.out.println("  Checking " + methodNodes.size() + " method nodes for cycles...");
        
        for (String startNode : methodNodes) {
            if (visited.contains(startNode)) continue;
            
            // Iterative DFS using explicit stack
            Set<String> currentPath = new HashSet<>();
            Deque<Iterator<String>> stack = new ArrayDeque<>();
            Deque<String> nodeStack = new ArrayDeque<>();
            
            nodeStack.push(startNode);
            currentPath.add(startNode);
            stack.push(getSuccessors(startNode).iterator());
            
            while (!stack.isEmpty()) {
                Iterator<String> it = stack.peek();
                
                if (!it.hasNext()) {
                    // Backtrack
                    stack.pop();
                    String popped = nodeStack.pop();
                    currentPath.remove(popped);
                    visited.add(popped);
                    continue;
                }
                
                String next = it.next();
                
                if (currentPath.contains(next)) {
                    // Cycle detected!
                    cycleNodes.add(next);
                    cycleNodes.addAll(currentPath);
                }
                
                if (!visited.contains(next)) {
                    nodeStack.push(next);
                    currentPath.add(next);
                    stack.push(getSuccessors(next).iterator());
                }
            }
            
            processed++;
            if (processed % 10000 == 0) {
                System.out.print(".");
            }
        }
        
        System.out.println("\n  ✅ Cycle detection complete");
        return cycleNodes;
    }
    
    /**
     * Find methods with external calls (calls to Java, Spring, etc.)
     */
    public List<GraphNode> findMethodsWithExternalCalls() {
        List<GraphNode> result = new ArrayList<>();
        for (GraphNode node : nodeMap.values()) {
            if (node.type == NodeType.METHOD) {
                List<String> externalCalls = node.get("externalCalls");
                if (externalCalls != null && !externalCalls.isEmpty()) {
                    result.add(node);
                }
            }
        }
        return result;
    }
    
    /**
     * Find methods that need mocking
     */
    public List<GraphNode> findMethodsNeedingMocks() {
        List<GraphNode> result = new ArrayList<>();
        for (GraphNode node : nodeMap.values()) {
            if (node.type == NodeType.METHOD) {
                List<String> externalCalls = node.get("externalCalls");
                List<String> siblingCalls = node.get("siblingCalls");
                if ((externalCalls != null && !externalCalls.isEmpty()) ||
                    (siblingCalls != null && !siblingCalls.isEmpty())) {
                    result.add(node);
                }
            }
        }
        return result;
    }
    
    /**
     * Get method call counts (popularity)
     */
    public Map<String, Integer> getMethodCallCounts() {
        Map<String, Integer> callCounts = new HashMap<>();
        for (GraphEdge edge : getAllEdges()) {
            if (edge.getType().equals("CALLS") || edge.getType().equals("CALLS_EXTERNAL")) {
                callCounts.merge(edge.getTo(), 1, Integer::sum);
            }
        }
        return callCounts;
    }
    
    /**
     * Get all edges
     */
    public List<GraphEdge> getAllEdges() {
        List<GraphEdge> allEdges = new ArrayList<>();
        for (List<GraphEdge> edges : outgoingEdges.values()) {
            allEdges.addAll(edges);
        }
        return allEdges;
    }
    
    /**
     * Find methods by line range (for JaCoCo integration)
     */
    public List<GraphNode> findMethodsByLineRange(String className, int lineNumber) {
        List<GraphNode> result = new ArrayList<>();
        for (GraphNode node : nodeMap.values()) {
            if (node.type == NodeType.METHOD) {
                String nodeClassName = node.get("className");
                Integer lineStart = node.get("lineStart");
                Integer lineEnd = node.get("lineEnd");
                
                if (className.equals(nodeClassName) && lineStart != null && lineEnd != null) {
                    if (lineNumber >= lineStart && lineNumber <= lineEnd) {
                        result.add(node);
                    }
                }
            }
        }
        return result;
    }
    
    /**
     * Load graph from JSON file
     */
    public void loadFromFile(String graphJsonPath) throws Exception {
        System.out.println("\n📦 Loading graph from: " + graphJsonPath);
        
        File graphFile = new File(graphJsonPath);
        if (!graphFile.exists()) {
            throw new IllegalArgumentException("File not found: " + graphJsonPath);
        }
        
        JsonNode root = mapper.readTree(graphFile);
        JsonNode nodes = root.get("nodes");
        
        if (nodes == null) {
            throw new IllegalArgumentException("No 'nodes' field found");
        }
        
        // Load Packages
        JsonNode packages = nodes.get("packages");
        if (packages != null && packages.isArray()) {
            for (JsonNode pkg : packages) {
                Map<String, Object> props = new HashMap<>();
                props.put("simpleName", pkg.get("simpleName").asText());
                addNode(pkg.get("qualifiedName").asText(), NodeType.PACKAGE, props);
            }
            System.out.println("  ✓ Loaded " + packages.size() + " packages");
        }
        
        // Load Classes
        JsonNode classes = nodes.get("classes");
        if (classes != null && classes.isArray()) {
            for (JsonNode cls : classes) {
                Map<String, Object> props = new HashMap<>();
                props.put("simpleName", cls.get("simpleName").asText());
                props.put("packageName", cls.get("packageName").asText());
                props.put("isInterface", cls.get("isInterface").asBoolean());
                props.put("isAbstract", cls.get("isAbstract").asBoolean());
                props.put("astDocId", cls.get("astDocId").asText());
                
                if (cls.has("sourceFile")) {
                    props.put("sourceFile", cls.get("sourceFile").asText());
                }
                if (cls.has("lineStart")) {
                    props.put("lineStart", cls.get("lineStart").asInt());
                }
                if (cls.has("lineEnd")) {
                    props.put("lineEnd", cls.get("lineEnd").asInt());
                }
                
                addNode(cls.get("id").asText(), NodeType.CLASS, props);
            }
            System.out.println("  ✓ Loaded " + classes.size() + " classes");
        }
        
        // Load Methods
        JsonNode methods = nodes.get("methods");
        if (methods != null && methods.isArray()) {
            int loaded = 0;
            for (JsonNode method : methods) {
                if (method.has("isExternal") && method.get("isExternal").asBoolean()) {
                    continue;
                }
                
                Map<String, Object> props = new HashMap<>();
                props.put("simpleName", method.get("simpleName").asText());
                props.put("className", method.get("className").asText());
                props.put("packageName", method.get("packageName").asText());
                props.put("returnType", method.has("returnType") ? 
                         method.get("returnType").asText() : "void");
                props.put("isPublic", method.get("isPublic").asBoolean());
                props.put("isStatic", method.get("isStatic").asBoolean());
                props.put("astDocId", method.get("astDocId").asText());
                
                if (method.has("lineStart")) {
                    props.put("lineStart", method.get("lineStart").asInt());
                }
                if (method.has("lineEnd")) {
                    props.put("lineEnd", method.get("lineEnd").asInt());
                }
                
                // Code snippets
                if (method.has("conditions") && method.get("conditions").isArray()) {
                    List<String> conditions = new ArrayList<>();
                    method.get("conditions").forEach(c -> conditions.add(c.asText()));
                    props.put("conditions", conditions);
                }
                
                if (method.has("nullChecks") && method.get("nullChecks").isArray()) {
                    List<String> nullChecks = new ArrayList<>();
                    method.get("nullChecks").forEach(nc -> nullChecks.add(nc.asText()));
                    props.put("nullChecks", nullChecks);
                }
                
                if (method.has("externalCalls") && method.get("externalCalls").isArray()) {
                    List<String> externalCalls = new ArrayList<>();
                    method.get("externalCalls").forEach(ec -> externalCalls.add(ec.asText()));
                    props.put("externalCalls", externalCalls);
                }
                
                if (method.has("siblingCalls") && method.get("siblingCalls").isArray()) {
                    List<String> siblingCalls = new ArrayList<>();
                    method.get("siblingCalls").forEach(sc -> siblingCalls.add(sc.asText()));
                    props.put("siblingCalls", siblingCalls);
                }
                
                if (method.has("mockCandidates") && method.get("mockCandidates").isArray()) {
                    List<String> mockCandidates = new ArrayList<>();
                    method.get("mockCandidates").forEach(mc -> mockCandidates.add(mc.asText()));
                    props.put("mockCandidates", mockCandidates);
                }
                
                addNode(method.get("id").asText(), NodeType.METHOD, props);
                loaded++;
            }
            System.out.println("  ✓ Loaded " + loaded + " methods");
        }
        
        // Load Edges
        JsonNode edges = root.get("edges");
        if (edges != null && edges.isArray()) {
            int edgeCount = 0;
            for (JsonNode edge : edges) {
                String fromId = edge.get("fromId").asText();
                String toId = edge.get("toId").asText();
                String type = edge.get("type").asText();
                
                Map<String, Object> props = new HashMap<>();
                JsonNode edgeProps = edge.get("props");
                if (edgeProps != null) {
                    if (edgeProps.has("lineNumber")) {
                        props.put("lineNumber", edgeProps.get("lineNumber").asInt());
                    }
                    if (edgeProps.has("callCount")) {
                        props.put("callCount", edgeProps.get("callCount").asInt());
                    }
                }
                
                addEdge(fromId, toId, type, props);
                edgeCount++;
            }
            System.out.println("  ✓ Loaded " + edgeCount + " edges");
        }
        
        System.out.println("✅ Graph loaded successfully");
    }
    
    /**
     * Print statistics
     */
    public void printStats() {
        System.out.println("\n📊 Graph Statistics:");
        System.out.println("  Total Nodes: " + nodeMap.size());
        System.out.println("  Total Edges: " + getAllEdges().size());
        
        long classCount = nodeMap.values().stream().filter(n -> n.type == NodeType.CLASS).count();
        long methodCount = nodeMap.values().stream().filter(n -> n.type == NodeType.METHOD).count();
        long packageCount = nodeMap.values().stream().filter(n -> n.type == NodeType.PACKAGE).count();
        
        System.out.println("    Classes: " + classCount);
        System.out.println("    Methods: " + methodCount);
        System.out.println("    Packages: " + packageCount);
        
        // Methods with external calls
        long methodsWithExternal = nodeMap.values().stream()
            .filter(n -> n.type == NodeType.METHOD)
            .filter(n -> {
                List<String> calls = n.get("externalCalls");
                return calls != null && !calls.isEmpty();
            })
            .count();
        
        System.out.println("  Methods with external calls: " + methodsWithExternal);
        
        // Top 10 most called methods
        Map<String, Integer> callCounts = getMethodCallCounts();
        System.out.println("\n  Top 10 most called methods:");
        callCounts.entrySet().stream()
            .sorted(Map.Entry.<String, Integer>comparingByValue().reversed())
            .limit(10)
            .forEach(entry -> {
                String methodId = entry.getKey();
                int count = entry.getValue();
                // Truncate long method names for display
                String shortName = methodId.length() > 80 ? 
                    methodId.substring(0, 77) + "..." : methodId;
                System.out.println("    " + shortName + " (" + count + " calls)");
            });
    }
    
    /**
     * Generate test recommendations
     */
    public String generateTestRecommendations(String methodId) {
        GraphNode method = getNode(methodId);
        if (method == null || method.type != NodeType.METHOD) {
            return "Method not found: " + methodId;
        }
        
        StringBuilder sb = new StringBuilder();
        sb.append("Test Recommendations for: ").append(methodId).append("\n\n");
        
        List<String> conditions = method.get("conditions");
        if (conditions != null && !conditions.isEmpty()) {
            sb.append("Paths to test:\n");
            for (int i = 0; i < Math.min(conditions.size(), 10); i++) {
                sb.append("  Path ").append(i + 1).append(": ").append(conditions.get(i)).append("\n");
            }
            if (conditions.size() > 10) {
                sb.append("  ... and ").append(conditions.size() - 10).append(" more\n");
            }
            sb.append("\n");
        }
        
        List<String> nullChecks = method.get("nullChecks");
        if (nullChecks != null && !nullChecks.isEmpty()) {
            sb.append("Null safety tests:\n");
            for (String check : nullChecks) {
                sb.append("  - Test with ").append(check).append("\n");
            }
            sb.append("\n");
        }
        
        List<String> externalCalls = method.get("externalCalls");
        if (externalCalls != null && !externalCalls.isEmpty()) {
            sb.append("Mocks needed:\n");
            for (String call : externalCalls) {
                sb.append("  - Mock: ").append(call).append("\n");
            }
            sb.append("\n");
        }
        
        List<String> callers = getCallers(methodId);
        if (!callers.isEmpty()) {
            sb.append("This method is called by ").append(callers.size()).append(" methods:\n");
            for (int i = 0; i < Math.min(callers.size(), 5); i++) {
                sb.append("  - ").append(callers.get(i)).append("\n");
            }
            if (callers.size() > 5) {
                sb.append("  ... and ").append(callers.size() - 5).append(" more\n");
            }
        }
        
        return sb.toString();
    }
    
    public static void main(String[] args) {
        String graphJsonPath = args.length > 0 ? args[0] : 
            "C:/Users/PrabalBhardwaj/Desktop/osttra-harmony3/dependency_graph.json";
        
        System.out.println("╔══════════════════════════════════════════════════════════╗");
        System.out.println("║     In-Memory Graph Storage - Harmony Codebase          ║");
        System.out.println("╚══════════════════════════════════════════════════════════╝");
        
        InMemoryGraphStorage storage = new InMemoryGraphStorage();
        
        try {
            long startTime = System.currentTimeMillis();
            
            // Load graph from file
            storage.loadFromFile(graphJsonPath);
            
            // Print statistics
            storage.printStats();
            
            // Detect cycles (iterative - safe for large graphs)
            Set<String> cycles = storage.detectCycles();
            if (!cycles.isEmpty()) {
                System.out.println("\n⚠️  Cycles detected: " + cycles.size() + " nodes involved");
                System.out.println("  Sample cycle nodes:");
                cycles.stream().limit(10).forEach(n -> System.out.println("    " + n));
            }
            
            long elapsed = System.currentTimeMillis() - startTime;
            System.out.println("\n⏱️  Total time: " + (elapsed / 1000.0) + " seconds");
            
        } catch (Exception e) {
            System.err.println("❌ Error: " + e.getMessage());
            e.printStackTrace();
        }
    }
